# ============================================================
# 环境变量模板
# 使用方法：复制本文件为 .env，填入你的真实配置。
# .env 已被 .gitignore 排除，不会被提交到仓库。
# ============================================================

# ---- LLM 生成服务（OpenAI 兼容接口）----
# 方案一：DeepSeek（https://platform.deepseek.com 注册并充值几元即可）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 方案二：硅基流动 SiliconFlow（https://siliconflow.cn，新用户送额度，
#          Qwen2.5-7B-Instruct 等模型免费）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 方案三：本地 Ollama（先 `ollama pull qwen2.5:7b-instruct`）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=ollama

# 留空时不报错：管线自动降级为“抽取式回答”模式（只用检索结果拼装答案，
# 不调用任何外部服务），方便无 Key 联调；正式评估请配置 API。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
